# =============================================
# Discord Bot - Variables de Entorno (PLANTILLA)
# =============================================
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas el `.env` real a git.

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
ADMIN_LOG_CHANNEL_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telegram Bot 1 (Acceso al canal) ---
TELEGRAM_TOKEN=
CHANNEL_ID=
CHANNEL_LINK=
TELEGRAM_ADMIN_ID=
LINK_BOT1=
LINK_BOT2=
LINK_BOT3=
LINK_BOT4=

# --- Telegram Bot 2 (Monkey Descargador) ---
MONKEY_TELEGRAM_TOKEN=

# --- Telegram Bot 3 (Cobro con Stars) - NUEVO bot independiente ---
# Token del bot nuevo (crea uno con @BotFather).
STARS_TELEGRAM_TOKEN=
# Username del bot SIN @ (p.ej. MiCobroBot), para armar el deep link t.me/<username>?start=<code>
STARS_TELEGRAM_BOT_USERNAME=

# --- Telegram Bot 4 (Quotly / Monkey stickers) ---
# Token del bot de stickers (podés reusar el mismo @monkeyquoubot del bot en Node).
MONKEY_QUOTLY_TOKEN=

# =============================================
# Instagram (contenido restringido / NSFW)
# =============================================
# Opción recomendada: configura las 3 variables con una cuenta que tenga
# edad verificada para maximizar la cobertura de posts restringidos.

# Usuario y contraseña de Instagram (usado por instaloader)
# ⚠️ NO usar cuentas con 2FA activado (instaloader no lo soporta).
IG_USERNAME=
IG_PASSWORD=

# Cookies en formato Netscape. Para obtenerlas:
# 1) Inicia sesión en instagram.com con la MISMA cuenta de arriba
# 2) Usa la extensión "Get cookies.txt LOCALLY" o "cookies.txt"
# 3) Pega TODO el contenido del archivo exportado aquí abajo
#    (incluyendo las líneas comentadas # Netscape HTTP Cookie File...)
IG_COOKIES=
